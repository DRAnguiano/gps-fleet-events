# Copia este archivo como .env y completa los valores.
# .env está en .gitignore: nunca lo subas al repositorio.

# ============================================================
# Base de datos
# ============================================================
POSTGRES_DB=gpsdb
POSTGRES_USER=gps
POSTGRES_PASSWORD=cambia_esto

# Usadas por los scripts de Node (backfill) y de respaldo.
PGHOST=postgres
PGPORT=5432
PGDATABASE=gpsdb
PGUSER=gps
PGPASSWORD=cambia_esto

# ============================================================
# Correo (fuente de eventos)
# Con Gmail usa una contraseña de aplicación, no la del correo.
# ============================================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=alertas@tuempresa.com
IMAP_PASS=contrasena_de_aplicacion

# Carpeta a procesar. El flujo en vivo lee INBOX; el backfill histórico
# lee una carpeta aparte para no competir con él.
IMAP_MAILBOX=HISTORICAL

# Correos por corrida del backfill.
BATCH_SIZE=20

# ============================================================
# RAG / LLM
# ============================================================
MODEL_NAME=phi3:mini
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_HOST=http://ollama:11434

DATA_DIR=/app/data
DB_DIR=/app/chroma_db

TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Similitud mínima para responder con documentos en vez de decir que no hay
# dato. Depende del modelo de embeddings: recalíbralo con POST /search si
# cambias EMBEDDING_MODEL.
RAG_MIN_SCORE=0.35

NUM_CTX=4096
NUM_PREDICT=1024
TEMPERATURE=0.40
REPEAT_PENALTY=1.05

REINDEX_CLEAN=false

# ============================================================
# Consultas operativas del bot
# Si DATABASE_URL queda vacío, /ask solo responde sobre documentos.
# ============================================================
DATABASE_URL=postgresql://gps:cambia_esto@postgres:5432/gpsdb
FLEET_TZ=America/Monterrey
FLEET_QUERY_TIMEOUT_S=5
FLEET_STALE_HOURS=1

# ============================================================
# Seguridad de la API
# ============================================================
# Si se define, /reindex exige el header X-API-Key.
REINDEX_API_KEY=

# Deja false en producción: en true expone trazas de error en la respuesta.
INCLUDE_ERROR_DETAILS=false

# ============================================================
# Automatización (n8n, Telegram, ngrok)
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

NGROK_AUTHTOKEN=
NGROK_DOMAIN=tu-dominio.ngrok-free.app

TZ=America/Monterrey
GENERIC_TIMEZONE=America/Monterrey

# ============================================================
# Respaldos
# ============================================================
BACKUP_DIR=./backups
RETENTION_DAYS=14
