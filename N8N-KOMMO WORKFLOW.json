            {
              "id": "8f5a106b-eb8b-49dd-a7b9-7ad1b841b125",
              "leftValue": "={{ $json[\"_embedded\"].contacts.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
